<?xml version="1.0" encoding="UTF-8"?>
<!-- ERZEUGT von qmake aus config.xml.in – Änderungen bitte dort vornehmen -->
<Installer>
    <Name>ViviaParms</Name>
    <Version>@VP_VERSION@</Version>
    <Title>ViviaParms @VP_VERSION@</Title>
    <Publisher>Michael Bergmann</Publisher>
    <StartMenuDir>ViviaParms</StartMenuDir>
    <TargetDir>C:/ViviaParms</TargetDir>
    <AdminTargetDir>C:/ViviaParms</AdminTargetDir>
    <AllowSpaceInPath>true</AllowSpaceInPath>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <RemoveTargetDir>true</RemoveTargetDir>
    <MaintenanceToolName>ViviaParms-Wartung</MaintenanceToolName>
    <InstallerApplicationIcon>viviaparms</InstallerApplicationIcon>
    <InstallerWindowIcon>viviaparms.png</InstallerWindowIcon>
    <Logo>logo.png</Logo>
    <Banner>banner.png</Banner>
    <Watermark>watermark.png</Watermark>
    <WizardStyle>Modern</WizardStyle>
    <WizardDefaultWidth>720</WizardDefaultWidth>
    <WizardDefaultHeight>520</WizardDefaultHeight>
    <RunProgram>@TargetDir@/ViviaParms.exe</RunProgram>
    <RunProgramDescription>ViviaParms starten / Start ViviaParms</RunProgramDescription>
    <ControlScript>controlscript.qs</ControlScript>
</Installer>
